---
import { formatCell, isNumericColumn, paginatesRows, pageCount, TABLE_PAGE_SIZE } from '../../lib/sections';
import { renderInline } from '../../lib/render';
import type { TableSection } from '../../lib/reportJson';

export interface Props {
  section: TableSection;
}
const { section } = Astro.props as Props;

const columns = Array.isArray(section.columns) ? section.columns : [];
const rows = Array.isArray(section.rows) ? section.rows : [];
const notes = Array.isArray(section.notes) ? section.notes : [];

// Computed once per table, not per cell: alignment is a property of the
// column, and `isNumericColumn` walks every row to decide it.
const numeric = columns.map((column) => isNumericColumn(column, rows));

const paginated = paginatesRows(section);
const pages = pageCount(rows.length);
---

<div class="dttw-table" data-paged={paginated ? 'true' : undefined} data-page-size={TABLE_PAGE_SIZE} data-pages={pages}>
  <div class="dttw-tablewrap">
    <table class="dttw-tbl">
      <thead>
        <tr>
          {columns.map((column, i) => (
            <th class:list={[numeric[i] && 'dttw-tbl__num']} scope="col">{column.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, rowIndex) => (
          <tr data-page={paginated ? Math.floor(rowIndex / TABLE_PAGE_SIZE) : undefined}>
            {columns.map((column, i) => {
              const cell = formatCell(row?.[column.key], column.type);
              return (
                <td
                  class:list={[numeric[i] && 'dttw-tbl__num', cell.isNull && 'dttw-tbl__null']}
                  data-align={numeric[i] ? undefined : 'left'}
                >{cell.text}</td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {paginated && (
    <div class="dttw-tpager" hidden>
      <span class="dttw-tpager__count" data-page-count aria-live="polite">Page 1 of {pages}</span>
      <button type="button" class="dttw-tpager__next" data-page-next>Next 10</button>
    </div>
  )}
  {notes.length > 0 &&
    notes.map((note) => <p class="dttw-tnote" set:html={renderInline(note)} />)}
</div>

<style>
  /* A nine-column waiver table cannot fit the article's measure, so the
     table scrolls inside its own box rather than widening the page — the
     same treatment `.md-table` gives markdown tables in global.css. */
  .dttw-tablewrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
  }

  .dttw-tbl {
    /* The pair is what makes the wrapper above actually scroll. `width: 100%`
       alone does not: with nowrap headers the table's min-content still
       exceeds a phone, so the wrapper inherits that width and pushes the page
       wide instead of scrolling. `max-content` lets columns take their natural
       width, `min-width` keeps narrow tables filling the box. */
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
  }

  .dttw-tbl th {
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: left;
    padding: 9px 16px;
    border-bottom: 1px solid var(--line-default);
    white-space: nowrap;
  }

  .dttw-tbl td {
    font: var(--type-body-sm);
    color: var(--text-secondary);
    padding: 10px 16px;
    border-bottom: 1px solid var(--line-subtle);
  }

  .dttw-table:not([data-paged]) .dttw-tbl tbody tr:last-child td {
    border-bottom: none;
  }

  .dttw-tbl tbody tr:hover td {
    background: var(--grey-50);
  }

  /* Numeric columns are mono and right-aligned so magnitudes line up. The
     declared column `type` alone does not earn this — `isNumericColumn`
     checks the rows, because the type is unvalidated upstream.

     Written against `td`/`th` rather than the bare class: `.dttw-tbl td` is
     the more specific selector once Astro scopes both, so a bare
     `.dttw-tbl__num` loses every property the element rule also sets. */
  .dttw-tbl td.dttw-tbl__num {
    font: var(--type-data);
    color: var(--text-primary);
  }
  .dttw-tbl__num {
    text-align: right;
  }
  .dttw-tbl th.dttw-tbl__num {
    color: var(--text-muted);
    text-align: right;
  }

  /* The load-bearing rule of this whole view: a null cell says "no reading"
     in disabled grey and never renders as 0. A bye week's offense_pct is
     null; a real 0.0 is a real zero, and the two must not look alike. */
  .dttw-tbl td.dttw-tbl__null {
    font: var(--type-data);
    color: var(--text-disabled);
  }
  .dttw-tbl__null[data-align='left'] {
    text-align: left;
  }

  /* notes[] keep the report's own phrasing verbatim — there the words are the
     data, so they sit with the table rather than being summarised away. */
  .dttw-tnote {
    font: var(--type-caption);
    font-style: italic;
    color: var(--text-muted);
    margin: 0;
    padding: 10px 16px;
    border: 1px solid var(--line-subtle);
    border-top: none;
    background: var(--surface-sunken);
  }
  .dttw-tnote:last-child {
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  /* Sits directly under .dttw-tablewrap, outside its overflow-x box, so the
     control never scrolls away on a wide table. Same border-continuation
     treatment as .dttw-tnote so table → pager → note reads as one box. */
  .dttw-tpager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--line-subtle);
    border-top: none;
    background: var(--surface-sunken);
    padding: 8px 16px;
  }
  .dttw-tpager:last-child {
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  .dttw-tpager__count {
    font: var(--type-caption);
    color: var(--text-muted);
  }

  .dttw-tpager__next {
    display: inline-flex;
    align-items: center;
    border-radius: 5px;
    font: var(--type-body-sm);
    padding: 6px 11px;
    border: 1px solid var(--line-default);
    background: var(--white);
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-control);
  }
  .dttw-tpager__next:hover {
    background: var(--surface-hover);
  }

  /* Desktop cell padding is 32px of the ~335px a phone has. Matching the
     density global.css already gives markdown tables means fewer columns
     fall off the edge before the reader has to scroll for them. `td` keeps
     wrapping — only the headers are nowrap, and that is enough to set the
     column widths. */
  @media (max-width: 700px) {
    .dttw-tbl th,
    .dttw-tbl td {
      padding: var(--space-1) var(--space-3);
    }
    .dttw-tbl td {
      font: var(--type-caption);
    }
    .dttw-tnote,
    .dttw-tpager {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
