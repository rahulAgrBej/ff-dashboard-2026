---
export interface Props {
  tone?: 'neutral' | 'alert' | 'positive';
}

const { tone = 'neutral' } = Astro.props as Props;
---

<span class:list={['dttw-badge', `dttw-badge--${tone}`]}>
  <slot />
</span>

<style>
  .dttw-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    font: var(--type-caption);
    font-weight: var(--fw-medium);
  }
  .dttw-badge--neutral {
    background: var(--surface-muted);
    color: var(--text-secondary);
  }
  .dttw-badge--alert {
    background: color-mix(in srgb, var(--alert-text) 12%, white);
    color: var(--alert-text);
  }
  /* Uses the design system's own positive ramp rather than a color-mix of a
     text colour, which is what the alert tone above had to do before the
     status families were available. */
  .dttw-badge--positive {
    background: var(--pos-bg);
    color: var(--pos-text);
  }
</style>
