---
import { dayLabel, type MergedSlot, type WeekSummary } from '../lib/schedule';
import { archiveUrl, dailyUrl } from '../lib/reports';

export interface Props {
  weeks: WeekSummary[];
  currentKey?: string;
  openWeeks?: number[];
  /** Which read surface the rows link into. The two sidebars are the same component because they show the same schedule; only the destination differs. */
  surface?: 'daily' | 'archive';
}
const { weeks, currentKey, openWeeks = [], surface = 'archive' } = Astro.props as Props;

const urlFor = surface === 'daily' ? dailyUrl : archiveUrl;

/**
 * On the daily surface a slot with no structured twin may still have a real
 * markdown report behind it. Those must not render as `pending` or `planned`:
 * "upstream has not produced this" and "produced, but with no structured
 * twin" are different facts, and the structured prefix started mid-season, so
 * the wrong one would be shown for most of the week.
 *
 * The archive surface never needs this — its own listing is the complete one.
 */
function markdownOnly(slot: MergedSlot): MergedSlot['markdownReport'] {
  if (surface !== 'daily' || slot.state === 'published') return undefined;
  return slot.markdownReport;
}

function rowLabel(slot: MergedSlot): string {
  const siblingCount = weeks.length ? weeks[0].slots.filter((s) => s.day === slot.day).length : 1;
  if (siblingCount > 1 && slot.short) return `${dayLabel(slot.day)} · ${slot.short}`;
  return dayLabel(slot.day);
}

function formatMmDd(iso: string): string {
  const [, m, d] = iso.split('-');
  return `${m}/${d}`;
}
---

<div class="dttw-index">
  {weeks.map((w) => (
    <details open={openWeeks.includes(w.week)}>
      <summary class="wkbtn">
        {w.label}
        {/* Counts what this surface can actually open, which on the daily
            sidebar includes the markdown-only rows. */}
        <span class="wkcount">
          {w.slots.filter((s) => s.state === 'published' || markdownOnly(s)).length}
        </span>
      </summary>
      <div class="dttw-index__rows">
        {w.slots.map((slot) =>
          markdownOnly(slot) ? (
            <a
              class="ixrow"
              data-markdown-only="true"
              href={archiveUrl(markdownOnly(slot)!)}
              title={`No structured twin — reads from the markdown archive`}
            >
              {rowLabel(slot)}
              <span class="ixdate">markdown only</span>
            </a>
          ) : slot.state === 'published' && slot.report ? (
            <a
              class="ixrow"
              href={urlFor(slot.report)}
              data-on={slot.report.key === currentKey ? 'true' : undefined}
              title={`Covers ${formatMmDd(slot.slotDate ?? slot.report.date)} · generated ${slot.report.date}`}
            >
              {rowLabel(slot)}
              <span class="ixdate">{formatMmDd(slot.slotDate ?? slot.report.date)}</span>
            </a>
          ) : slot.state === 'pending' ? (
            <div class="ixrow" data-pending="true">
              {rowLabel(slot)}
              <span class="ixdate">pending</span>
            </div>
          ) : (
            <div class="ixrow" data-planned="true">
              {rowLabel(slot)}
              <span class="ixdate">planned</span>
            </div>
          )
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .dttw-index {
    display: flex;
    flex-direction: column;
  }
  details {
    border-bottom: none;
  }
  details + details {
    margin-top: var(--space-2);
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .dttw-index__rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
  }

  /* Reachable, so it reads as a link rather than a disabled placeholder —
     but muted, because it leaves this surface. */
  .ixrow[data-markdown-only='true'] .ixdate {
    color: var(--text-disabled);
    font-style: italic;
  }
</style>
