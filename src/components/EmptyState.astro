---
import Icon from './ui/Icon.astro';
import type { Props as IconProps } from './ui/Icon.astro';

export interface Props {
  /** The original form: an S3 failure or an empty bucket, where the only thing to say is why. Keeps "No report to show" as the heading. */
  reason?: string;
  /** The design system's form: an expected, named absence — a summary that has not been generated yet, a news call that failed. */
  title?: string;
  description?: string;
  icon?: IconProps['name'];
  /** Tightens the padding for a state sitting inside a section rather than standing in for a whole page. */
  compact?: boolean;
  /** The page-level form is bare; the section-level form gets the design system's dashed container so it reads as a placeholder rather than content. */
  framed?: boolean;
}

const {
  reason,
  title = 'No report to show',
  description = reason,
  icon,
  compact = false,
  framed = false,
} = Astro.props as Props;
---

<div class:list={['dttw-empty', framed && 'dttw-empty--framed', compact && 'dttw-empty--compact']}>
  {icon && (
    <span class="dttw-empty__icon">
      <Icon name={icon} size={20} />
    </span>
  )}
  <p class="dttw-empty__title">{title}</p>
  {description && <p class="dttw-empty__reason">{description}</p>}
  {/* Action slot, matching the design system's EmptyState `action` prop —
      a placeholder that names a way forward beats one that only names the
      problem. Renders nothing when no caller fills it. */}
  <slot />
</div>

<style>
  .dttw-empty {
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }

  /* Ported from the design system's EmptyState: a dashed outline and a sunken
     ground, so a placeholder cannot be mistaken for a card with content in
     it. Only applied when `framed` is set — the page-level empty state was
     already bare and stays that way. */
  .dttw-empty--framed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    border: 1px dashed var(--line-default);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    padding: var(--space-10) var(--space-7);
  }

  .dttw-empty--compact {
    padding: var(--space-7);
  }

  .dttw-empty__icon {
    color: var(--text-disabled);
    display: inline-flex;
  }

  .dttw-empty__title {
    font: var(--type-title-3);
    letter-spacing: var(--ls-title-3);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .dttw-empty__reason {
    font: var(--type-body-sm);
    color: var(--text-muted);
    margin: 0;
    max-width: 380px;
    text-wrap: pretty;
  }

  /* `gap` already spaces the framed variant; the margin would double it. */
  .dttw-empty--framed .dttw-empty__title {
    margin: 0;
  }

  /* The unframed variant has no flex gap to space an action against. */
  .dttw-empty:not(.dttw-empty--framed) :global(.dttw-empty__action) {
    margin-top: var(--space-5);
  }
</style>
