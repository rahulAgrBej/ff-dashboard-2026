---
import Badge from './ui/Badge.astro';

export interface Props {
  html: string;
  model: string;
  generatedAt: string;
  stale: boolean;
}

const { html, model, generatedAt, stale } = Astro.props as Props;
---

<section class="dttw-ai" data-stale={stale ? 'true' : 'false'}>
  <div class="dttw-ai__head">
    <span class="flabel">AI summary</span>
    {stale && <Badge tone="alert">Describes an earlier render</Badge>}
  </div>
  <div class="md" set:html={html} />
  <p class="dttw-ai__meta">
    Generated by <code>{model}</code> · {generatedAt}
  </p>
</section>

<style>
  /* Deliberately not `.callout`: that treatment means "part of this
     report". A generated summary is a separate artifact with a separate
     lifecycle, so it gets a container of its own that cannot be mistaken
     for the report's own deterministic output. */
  .dttw-ai {
    border: 1px solid var(--line-default);
    border-left: 3px solid var(--blue-500);
    border-radius: 5px;
    background: var(--surface-sunken);
    padding: var(--space-5) var(--space-6);
  }

  .dttw-ai[data-stale='true'] {
    border-left-color: var(--alert-text);
  }

  .dttw-ai__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .dttw-ai__head .flabel {
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .dttw-ai__meta {
    margin: var(--space-4) 0 0;
    font: var(--type-caption);
    color: var(--text-muted);
  }

  .dttw-ai__meta code {
    font: var(--type-data);
    font-size: 11.5px;
  }
</style>
