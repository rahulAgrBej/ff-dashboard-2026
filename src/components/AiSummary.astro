---
import Badge from './ui/Badge.astro';
import Alert from './ui/Alert.astro';

export interface Props {
  html: string;
  model: string;
  generatedAt: string;
  stale: boolean;
  /** How many earlier reports were given to the model as context. Shown as a count, not a list — they are inputs to the prose, not sources for it. */
  priorReports?: number;
}

const { html, model, generatedAt, stale, priorReports = 0 } = Astro.props as Props;
---

<section class="dttw-ai" data-stale={stale ? 'true' : 'false'}>
  {/* Staleness is not a caveat on the prose, it is a reason to distrust all
      of it: `report.sha256` no longer matches the text beside it, so this
      summary describes a different render of the same key. */}
  {stale && (
    <div class="dttw-ai__alert">
      <Alert tone="negative" icon="alert-triangle" title="This summary describes an older version of the report">
        Its stored digest does not match the report text on this page. Re-run the summariser before trusting the prose below.
      </Alert>
    </div>
  )}
  <div class="md" set:html={html} />
  <div class="dttw-ai__foot">
    <span class="mono">{model}</span>
    <span class="mono">{generatedAt}</span>
    {priorReports > 0 && (
      <span class="mono">{priorReports} prior {priorReports === 1 ? 'report' : 'reports'} in context</span>
    )}
    <div class="dttw-ai__spacer"></div>
    {stale ? <Badge tone="alert">Digest mismatch</Badge> : <Badge tone="positive">Matches report</Badge>}
  </div>
</section>

<style>
  /* Deliberately not `.callout`: that treatment means "part of this
     report". A generated summary is a separate artifact with a separate
     lifecycle, so it gets a container of its own that cannot be mistaken
     for the report's own deterministic output. */
  .dttw-ai {
    border: 1px solid var(--line-default);
    border-left: 3px solid var(--blue-500);
    border-radius: 5px;
    background: var(--surface-sunken);
    padding: var(--space-5) var(--space-6);
  }

  .dttw-ai[data-stale='true'] {
    border-left-color: var(--alert-text);
  }

  .dttw-ai__alert {
    margin-bottom: var(--space-5);
  }

  .dttw-ai__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-subtle);
  }

  .dttw-ai__spacer {
    flex: 1;
  }

  @media (max-width: 700px) {
    .dttw-ai {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
