---
import Badge from './ui/Badge.astro';
import Alert from './ui/Alert.astro';
import { formatAsOf, noFindingKind, ungroundedGroups, type RosterNews, type RosterNewsGroup } from '../lib/news';

export interface Props {
  news: RosterNews;
  sources: { uri: string; title: string; host: string }[];
  model: string;
  generatedAt: string;
  grounded: boolean;
  searchQueryCount: number;
  /** The roster export the player identities came from. Identity is authoritative from this file, never from the model. */
  rosterExport?: string | null;
  rosterWeek?: number | null;
}

const {
  news,
  sources,
  model,
  generatedAt,
  grounded,
  searchQueryCount,
  rosterExport,
  rosterWeek,
} = Astro.props as Props;

// Top-level `grounded: false` means *at least one* group is unsourced; the
// per-group flag is where the answer is. Naming the groups is the whole
// point — a footnote saying "a group" leaves the reader to guess.
const unsourced = ungroundedGroups(news);

/** "Starters", "Starters and Bench", "Starters, Bench and Injured reserve". */
function listNames(names: string[]): string {
  if (names.length <= 1) return names[0] ?? '';
  return `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
}

/**
 * How many quiet rows a group shows before collapsing the rest.
 *
 * Only ever applied to a group that is *expected* to be quiet. A bench is
 * asked only about change, so a searched-and-empty bench row is the normal
 * answer and collapsing it hides nothing a reader wanted. A starter with no
 * news is a finding, and is never collapsed.
 */
const QUIET_VISIBLE = 2;

/**
 * Splits a group into rows to show and rows to fold away.
 *
 * Only `searched-empty` rows are ever folded. A `not-covered` row is the one
 * thing in a bench that is *not* "no change reported" — the search never
 * returned an entry, so nothing is known either way — and folding it under
 * that label would state a coverage gap as a quiet week. It stays visible
 * however long the bench is.
 */
function quietSplit(group: RosterNewsGroup) {
  if (group.key !== 'bench') return { shown: group.players, hidden: [] as typeof group.players };
  const foldable = group.players.filter((p) => !p.found && noFindingKind(p) === 'searched-empty');
  const keep = group.players.filter((p) => !foldable.includes(p));
  return {
    shown: [...keep, ...foldable.slice(0, QUIET_VISIBLE)],
    hidden: foldable.slice(QUIET_VISIBLE),
  };
}

const NO_FINDING_COPY = {
  'searched-empty': 'Search ran, nothing found.',
  'not-covered': 'No entry returned for this player.',
  unknown: 'No news for this player.',
} as const;
---

<section class="dttw-news" data-grounded={grounded ? 'true' : 'false'}>
  {unsourced.length > 0 && (
    <div class="dttw-news__alert">
      <Alert
        tone="alert"
        icon="alert-triangle"
        title={`${listNames(unsourced.map((g) => g.label))} answered without grounding`}
      >
        The search never fired for {unsourced.length === 1 ? 'that group' : 'those groups'}, so its items came
        from the model's own recall rather than anything read today. Shown, and marked on the group.
      </Alert>
    </div>
  )}

  {news.groups.map((group) => {
    const split = quietSplit(group);
    return (
      <div class="dttw-news__group">
        <div class="dttw-news__grouphead">
          <span class="dttw-news__grouplabel">{group.label}</span>
          {group.ask && <span class="dttw-news__ask">{group.ask}</span>}
          <div class="dttw-news__groupright">
            {/* `skipped` is checked first: a group entry has either the full
                measurement keys or exactly one `skipped` key, never both. */}
            {group.skipped ? (
              <Badge tone="neutral">Skipped</Badge>
            ) : (
              <>
                <span class="dttw-news__count">
                  {group.foundCount} of {group.totalCount} with news
                </span>
                {group.grounded === false ? (
                  <Badge tone="alert">Ungrounded</Badge>
                ) : group.grounded === true ? (
                  <Badge tone="positive">Grounded</Badge>
                ) : null}
                {group.sourceCount > 0 && (
                  <span class="mono">{group.sourceCount} {group.sourceCount === 1 ? 'source' : 'sources'}</span>
                )}
              </>
            )}
          </div>
        </div>

        {group.skipped ? (
          <p class="dttw-news__skipped">{group.skipped}</p>
        ) : (
          <ul class="dttw-news__list">
            {split.shown.map((player) => {
              const kind = player.found ? null : noFindingKind(player);
              const asOf = formatAsOf(player.as_of);
              return (
                <li class="dttw-news__item" data-found={player.found ? 'true' : 'false'}>
                  <div class="dttw-news__who">
                    <p class="dttw-news__name">{player.player_name ?? `Player ${player.player_id}`}</p>
                    <p class="dttw-news__meta">
                      {[player.position, player.pro_team, player.lineup_slot && `slot ${player.lineup_slot}`]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {/* The league's own designation as of the last export,
                        which may be days old. Labelled as such: it is
                        context, not current status, and must not be read as
                        news sitting beside a fresh headline. */}
                    {player.espn_injury_status && (
                      <p class="dttw-news__status">
                        ESPN designation, last export: <b>{player.espn_injury_status}</b>
                      </p>
                    )}
                  </div>

                  {player.found ? (
                    <div class="dttw-news__body">
                      <p class="dttw-news__headline">{player.headline}</p>
                      {player.detail && <p class="dttw-news__detail">{player.detail}</p>}
                      <p class="dttw-news__foot">
                        {/* An undated item leaves `as_of` empty on purpose,
                            rather than defaulting to today. Falling back to
                            `generated_at` would undo that. */}
                        {asOf ? <span>As of {asOf}</span> : <span class="dttw-news__undated">Date not established</span>}
                        {group.grounded === false && <span class="dttw-news__undated">Unsourced — model recall</span>}
                      </p>
                    </div>
                  ) : (
                    <div class="dttw-news__body">
                      <p class="dttw-news__none">
                        {kind === 'not-covered' && <Badge tone="alert">Not covered</Badge>}
                        {NO_FINDING_COPY[kind ?? 'unknown']}
                      </p>
                      {/* Silence and "no news" are different findings. A
                          search that ran and found nothing is a real result;
                          a player the model skipped is a coverage gap, and
                          nothing was learned about them either way. */}
                      <p class="dttw-news__note">
                        {kind === 'searched-empty'
                          ? 'A search ran for this player and returned nothing — a real finding.'
                          : kind === 'not-covered'
                            ? 'The model returned no entry at all — a coverage gap, not a quiet week.'
                            : player.note}
                      </p>
                    </div>
                  )}
                </li>
              );
            })}

            {split.hidden.length > 0 && (
              <li class="dttw-news__item" data-found="false">
                <details class="dttw-news__more">
                  <summary>
                    {split.hidden.length} more bench {split.hidden.length === 1 ? 'player' : 'players'} · no change reported
                  </summary>
                  <ul class="dttw-news__morelist">
                    {/* Every row in here is searched-empty by construction —
                        see `quietSplit`. A coverage gap is never folded. */}
                    {split.hidden.map((player) => (
                      <li>
                        <span class="dttw-news__name">{player.player_name ?? `Player ${player.player_id}`}</span>
                        <span class="dttw-news__meta">
                          {[player.position, player.pro_team].filter(Boolean).join(' · ')}
                        </span>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            )}
          </ul>
        )}
      </div>
    );
  })}

  {sources.length > 0 && (
    <p class="dttw-news__sources">
      <span class="dttw-news__sourcelabel">Sources</span>
      {sources.map((source) => (
        <a href={source.uri} target="_blank" rel="noopener noreferrer nofollow" title={source.title || source.uri}>
          {source.host}
        </a>
      ))}
    </p>
  )}

  <p class="dttw-news__provenance">
    <span class="mono">{model}</span>
    <span class="mono">{generatedAt}</span>
    {rosterExport && (
      <span class="mono">roster {rosterExport}{rosterWeek ? ` · week ${rosterWeek}` : ''}</span>
    )}
    {/* A billing figure, not a quality one: 40 searches is more expensive
        than 12, not better researched. Phrased so it cannot read as depth. */}
    {searchQueryCount > 0 && (
      <span class="mono">{searchQueryCount} {searchQueryCount === 1 ? 'query' : 'queries'} billed</span>
    )}
  </p>
</section>

<style>
  /* A generated artifact with its own lifecycle gets a container that cannot
     be mistaken for the report's own deterministic output. Grey rather than
     the summary's blue because the two sit adjacent and are different
     artifacts. */
  .dttw-news {
    border: 1px solid var(--line-default);
    border-left: 3px solid var(--grey-500);
    border-radius: var(--radius-sm);
    background: var(--surface-page);
    overflow: hidden;
  }

  /* Ungrounded means the items came from recall, the one failure mode nobody
     downstream can detect by reading the text. */
  .dttw-news[data-grounded='false'] {
    border-left-color: var(--alert-text);
  }

  .dttw-news__alert {
    padding: var(--space-5) var(--space-6) 0;
  }

  .dttw-news__grouphead {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-4) var(--space-6);
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--line-subtle);
    border-top: 1px solid var(--line-subtle);
  }
  .dttw-news__group:first-of-type .dttw-news__grouphead {
    border-top: none;
  }

  .dttw-news__grouplabel {
    font: var(--type-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .dttw-news__ask {
    font: var(--type-caption);
    color: var(--text-muted);
  }

  .dttw-news__groupright {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .dttw-news__count,
  .dttw-news__skipped {
    font: var(--type-caption);
    color: var(--text-muted);
  }

  .dttw-news__skipped {
    margin: 0;
    padding: var(--space-4) var(--space-6);
  }

  .dttw-news__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dttw-news__item {
    display: grid;
    grid-template-columns: 216px 1fr;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--line-subtle);
  }
  .dttw-news__item:last-child {
    border-bottom: none;
  }

  /* Every rostered player is rendered, so the difference between a finding
     and a blank has to be carried by weight rather than by presence. */
  .dttw-news__item[data-found='false'] {
    background: var(--surface-sunken);
  }

  .dttw-news__name {
    font: var(--type-body);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    margin: 0;
  }

  .dttw-news__meta {
    font: var(--type-data);
    color: var(--text-muted);
    margin: 3px 0 0;
  }

  .dttw-news__status {
    margin: var(--space-2) 0 0;
    font: var(--type-caption);
    color: var(--text-muted);
  }
  .dttw-news__status b {
    font: var(--type-data);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
  }

  .dttw-news__body {
    min-width: 0;
  }

  .dttw-news__headline {
    font: var(--type-body);
    color: var(--text-primary);
    margin: 0;
    text-wrap: pretty;
  }

  .dttw-news__detail {
    font: var(--type-body-sm);
    color: var(--text-secondary);
    margin: var(--space-2) 0 0;
    max-width: 72ch;
    text-wrap: pretty;
  }

  .dttw-news__foot {
    margin: var(--space-3) 0 0;
    font: var(--type-caption);
    color: var(--text-muted);
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .dttw-news__undated {
    color: var(--alert-text);
  }

  .dttw-news__none {
    margin: 0;
    font: var(--type-body-sm);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .dttw-news__note {
    margin: var(--space-1) 0 0;
    font: var(--type-caption);
    color: var(--text-disabled);
  }

  .dttw-news__more summary {
    font: var(--type-body-sm);
    color: var(--text-muted);
    cursor: pointer;
  }
  .dttw-news__morelist {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .dttw-news__morelist li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .dttw-news__morelist .dttw-news__meta {
    margin: 0;
  }

  .dttw-news__sources {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--line-subtle);
    font: var(--type-caption);
  }

  .dttw-news__sourcelabel {
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-muted);
  }

  .dttw-news__sources a {
    color: var(--text-secondary);
  }

  .dttw-news__provenance {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--line-subtle);
    background: var(--surface-sunken);
  }

  /* The two-column row assumes room the phone does not have. */
  @media (max-width: 700px) {
    .dttw-news__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-4);
    }
    .dttw-news__grouphead,
    .dttw-news__sources,
    .dttw-news__provenance,
    .dttw-news__skipped {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .dttw-news__alert {
      padding: var(--space-4) var(--space-4) 0;
    }
    .dttw-news__ask {
      display: none;
    }
  }
</style>
