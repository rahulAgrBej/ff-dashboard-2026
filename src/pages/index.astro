---
import Shell from '../layouts/Shell.astro';
import ReportHeader from '../components/ReportHeader.astro';
import FreshnessRow from '../components/FreshnessRow.astro';
import ReportArticle from '../components/ReportArticle.astro';
import AiSummary from '../components/AiSummary.astro';
import RosterNews from '../components/RosterNews.astro';
import NewsUnavailable from '../components/NewsUnavailable.astro';
import NextReportNote from '../components/NextReportNote.astro';
import ReportIndex from '../components/ReportIndex.astro';
import EmptyState from '../components/EmptyState.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import { getEnv } from '../lib/env';
import { getObject, S3Error } from '../lib/s3';
import { getCachedBody, PAGE_CACHE_CONTROL } from '../lib/cache';
import { attachDatelines, extractTitle, formatGeneratedAt, loadReports, summaryCaption, type ReportMeta } from '../lib/reports';
import { renderReport, renderSummary } from '../lib/render';
import { formatSummaryTimestamp, loadSummary } from '../lib/summaries';
import { buildRosterNews, collectSources, formatNewsTimestamp, isRenderableNews } from '../lib/news';
import { buildWeekSummaries, collectWeekWindows, latestReport, nextReportNote, weekDateRange } from '../lib/schedule';

const env = getEnv();
const bypass = Astro.url.searchParams.get('nocache') === '1';

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

let reports: ReportMeta[];
let emptyReason: string | null = null;
try {
  reports = await loadReports(env, bypass);
  reports = await attachDatelines(env, reports, bypass);
} catch (err) {
  reports = [];
  emptyReason = err instanceof S3Error ? err.message : 'S3 is unreachable.';
}

const latest = !emptyReason ? latestReport(reports) : undefined;
if (!emptyReason && !latest) emptyReason = 'No reports were found in the bucket.';

let markdown = '';
if (!emptyReason && latest) {
  try {
    markdown = await getCachedBody(latest.key, latest.etag, bypass, () => getObject(env, latest.key));
  } catch (err) {
    emptyReason = err instanceof S3Error ? err.message : 'Could not read the latest report.';
  }
}

// Additive and best-effort: `loadSummary` never throws, and a report with
// no summary yet (normal for ~20 minutes after it publishes) renders alone.
const summary = !emptyReason && latest ? await loadSummary(env, latest, markdown, bypass) : null;

// The news layer rides the summary envelope, so it costs no extra fetch.
// Both layers are guarded independently: upstream generates them with
// separate calls that fail separately, and a dead news call must not take
// the summary beside it off the page (or the reverse).
const newsBlock = summary && isRenderableNews(summary.news) ? summary.news : null;
const rosterNews = newsBlock ? buildRosterNews(newsBlock) : null;
const newsError = summary && !newsBlock && summary.news_error ? summary.news_error : null;

const now = new Date();
const weekSummaries = !emptyReason ? buildWeekSummaries(reports, now) : [];
const currentWeek = latest ? weekSummaries.find((w) => w.season === latest.season && w.week === latest.week) : undefined;
const currentSlot = currentWeek?.slots.find((s) => s.report?.key === latest?.key);
const upcoming = currentWeek ? nextReportNote(currentWeek.slots, currentSlot) : undefined;

const title = markdown ? extractTitle(markdown) : 'Report';
const rendered = markdown ? renderReport(markdown) : null;
const generatedAt = rendered?.dateline?.renderedAt ?? (latest ? formatGeneratedAt(latest.lastModified) : '');
const typeKey = currentSlot?.key ?? latest?.day ?? '';
const weekWindowLabel = latest ? weekDateRange(latest.season, latest.week, collectWeekWindows(reports))?.label : undefined;
const covers = rendered?.dateline?.covers ?? null;
---

<Shell title={`${title} · Down to the Wire`} activeTab="latest" showTopbarActions={!emptyReason} hasAside={!emptyReason}>
  {emptyReason ? (
    <EmptyState reason={emptyReason} />
  ) : (
    <>
      <ReportHeader
        weekLabel={`Week ${latest!.week}`}
        weekWindowLabel={weekWindowLabel}
        covers={covers}
        title={title}
        generatedAt={generatedAt}
        typeKey={typeKey}
      />
      {rosterNews && newsBlock && (
        <RosterNews
          news={rosterNews}
          sources={collectSources(newsBlock)}
          model={newsBlock.model}
          generatedAt={formatNewsTimestamp(newsBlock.generated_at)}
          grounded={newsBlock.grounded !== false}
          searchQueryCount={newsBlock.search_query_count ?? 0}
        />
      )}
      {newsError && <NewsUnavailable reason={newsError} />}
      <FreshnessRow entries={rendered!.freshness} />
      {summary && (
        <AiSummary
          html={renderSummary(summary.summary_markdown)}
          model={summary.model}
          generatedAt={formatSummaryTimestamp(summary.generated_at)}
          stale={summary.stale}
        />
      )}
      <ReportArticle bodyHtml={rendered!.bodyHtml} rawMarkdown={markdown} cannotSeeHtml={rendered!.cannotSeeHtml} />
      <NextReportNote nextSlot={upcoming} />
    </>
  )}

  <Fragment slot="topbar-actions">
    <div class="seg">
      <button type="button" data-view-btn="rendered" data-on="true">Rendered</button>
      <button type="button" data-view-btn="raw">Markdown</button>
    </div>
    <Button variant="secondary" size="sm" data-action="print">
      <Icon name="printer" size={14} /> Print
    </Button>
    <Button variant="primary" size="sm" data-action="copy">
      <Icon name="copy" size={14} /> <span data-copy-label>Copy markdown</span>
    </Button>
  </Fragment>

  <Fragment slot="aside">
    <Card title="All reports" subtitle="By week and day" padding="tight">
      <ReportIndex weeks={weekSummaries} currentKey={latest?.key} openWeeks={currentWeek ? [currentWeek.week] : []} />
    </Card>
    <p class="dttw-caption">{summaryCaption(reports)}</p>
  </Fragment>
</Shell>

<style>
  .dttw-caption {
    margin: var(--space-4) 0 0;
    font: var(--type-caption);
    color: var(--text-muted);
  }
</style>
