---
import Shell from '../layouts/Shell.astro';
import DailyView from '../components/report/DailyView.astro';
import DailyAside from '../components/report/DailyAside.astro';
import DailyEmpty from '../components/report/DailyEmpty.astro';
import { getEnv } from '../lib/env';
import { PAGE_CACHE_CONTROL } from '../lib/cache';
import { loadDailyPage } from '../lib/page';

const bypass = Astro.url.searchParams.get('nocache') === '1';
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const page = await loadDailyPage(getEnv(), bypass, { kind: 'latest' });
const title = page.envelope ? page.envelope.header.title : 'Daily report';
---

<Shell title={`${title} · Down to the Wire`} activeTab="daily" hasAside={!page.emptyReason}>
  {page.emptyReason ? <DailyEmpty page={page} /> : <DailyView page={page} />}

  <Fragment slot="aside">
    {!page.emptyReason && <DailyAside page={page} />}
  </Fragment>
</Shell>
