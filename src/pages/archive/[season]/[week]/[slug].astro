---
import Shell from '../../../../layouts/Shell.astro';
import ReportHeader from '../../../../components/ReportHeader.astro';
import FreshnessRow from '../../../../components/FreshnessRow.astro';
import ReportArticle from '../../../../components/ReportArticle.astro';
import AiSummary from '../../../../components/AiSummary.astro';
import RosterNews from '../../../../components/RosterNews.astro';
import NewsUnavailable from '../../../../components/NewsUnavailable.astro';
import NextReportNote from '../../../../components/NextReportNote.astro';
import ReportIndex from '../../../../components/ReportIndex.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import Card from '../../../../components/ui/Card.astro';
import Icon from '../../../../components/ui/Icon.astro';
import Button from '../../../../components/ui/Button.astro';
import { getEnv } from '../../../../lib/env';
import { PAGE_CACHE_CONTROL } from '../../../../lib/cache';
import { loadArchivePage } from '../../../../lib/page';
import { summaryCaption, dailyUrl } from '../../../../lib/reports';
import { renderSummary } from '../../../../lib/render';
import { formatSummaryTimestamp } from '../../../../lib/summaries';
import { collectSources, formatNewsTimestamp } from '../../../../lib/news';

const bypass = Astro.url.searchParams.get('nocache') === '1';
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const page = await loadArchivePage(getEnv(), bypass, {
  kind: 'slug',
  season: Number(Astro.params.season),
  week: Number(Astro.params.week),
  slug: Astro.params.slug as string,
});

if (page.notFound) Astro.response.status = 404;

const current = page.current;
// Offered only when the twin is really there. The four reports that predate
// the structured prefix have none, and the archive is the only place they
// exist at all.
const structuredHref = current && page.hasStructuredTwin ? dailyUrl(current) : null;
---

<Shell
  title={`${page.title} · Down to the Wire`}
  activeTab="archive"
  showTopbarActions={!page.emptyReason}
  hasAside={!page.emptyReason}
>
  {page.emptyReason ? (
    <EmptyState reason={page.emptyReason} />
  ) : (
    <>
      <ReportHeader
        eyebrow={page.isLatest ? 'Most recent · markdown' : 'Markdown'}
        weekLabel={`Week ${current!.week}`}
        weekWindowLabel={page.weekWindowLabel}
        covers={page.covers}
        title={page.title}
        generatedAt={page.generatedAt}
        typeKey={page.currentSlot?.key ?? current!.day}
      />
      {structuredHref && (
        <p class="dttw-twin">
          <Button variant="secondary" size="sm" as="a" href={structuredHref}>
            <Icon name="layout-dashboard" size={14} /> Open the structured view
          </Button>
        </p>
      )}
      {page.rosterNews && page.newsBlock && (
        <RosterNews
          news={page.rosterNews}
          sources={collectSources(page.newsBlock)}
          model={page.newsBlock.model}
          generatedAt={formatNewsTimestamp(page.newsBlock.generated_at)}
          grounded={page.newsBlock.grounded !== false}
          searchQueryCount={page.newsBlock.search_query_count ?? 0}
          rosterExport={page.newsBlock.roster_export}
          rosterWeek={page.newsBlock.roster_week}
        />
      )}
      {page.newsError && <NewsUnavailable reason={page.newsError} />}
      <FreshnessRow entries={page.rendered!.freshness} />
      {page.summary && (
        <AiSummary
          html={renderSummary(page.summary.summary_markdown)}
          model={page.summary.model}
          generatedAt={formatSummaryTimestamp(page.summary.generated_at)}
          stale={page.summary.stale}
          priorReports={page.summary.prior_reports?.length ?? 0}
        />
      )}
      <ReportArticle
        bodyHtml={page.rendered!.bodyHtml}
        rawMarkdown={page.markdown}
        cannotSeeHtml={page.rendered!.cannotSeeHtml}
      />
      <NextReportNote nextSlot={page.upcoming} />
    </>
  )}

  <Fragment slot="topbar-actions">
    <div class="seg">
      <button type="button" data-view-btn="rendered" data-on="true">Rendered</button>
      <button type="button" data-view-btn="raw">Markdown</button>
    </div>
    <Button variant="secondary" size="sm" data-action="print">
      <Icon name="printer" size={14} /> Print
    </Button>
    <Button variant="primary" size="sm" data-action="copy">
      <Icon name="copy" size={14} /> <span data-copy-label>Copy markdown</span>
    </Button>
  </Fragment>

  <Fragment slot="aside">
    <Card title="All markdown files" subtitle="By week and day" padding="tight">
      <ReportIndex
        weeks={page.weeks}
        currentKey={current?.key}
        openWeeks={page.currentWeek ? [page.currentWeek.week] : []}
        surface="archive"
      />
    </Card>
    <p class="dttw-caption">{summaryCaption(page.reports)}</p>
  </Fragment>
</Shell>

<style>
  .dttw-twin {
    margin: 0;
  }
  .dttw-caption {
    margin: var(--space-4) 0 0;
    font: var(--type-caption);
    color: var(--text-muted);
  }
</style>
